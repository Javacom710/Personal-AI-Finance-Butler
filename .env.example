# ---------------------------------------------------------------------------
# Finance OS — environment
#
# Copy to `.env` and fill in. `.env*` is git-ignored; this file is not.
# Every variable here is validated by src/lib/env.ts at startup, which refuses
# to boot on anything missing or malformed (SECURITY.md §3).
#
# Nothing in this file may ever be prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The application role. SELECT/INSERT/UPDATE/DELETE on data tables; INSERT and
# SELECT only on audit_log, which is append-only (SECURITY.md §2, §10).
# It deliberately cannot run DDL.
DATABASE_URL=postgres://financeos_app:CHANGE_ME@127.0.0.1:5432/financeos

# The migration role. Owns the schema and is the only role that may run DDL.
# Used by `npm run db:migrate` and `npm run db:seed` — never by the running
# application process.
DATABASE_MIGRATION_URL=postgres://financeos_migrator:CHANGE_ME@127.0.0.1:5432/financeos

# Integration tests migrate and truncate this database. It must not be the
# development database — the harness truncates every table between files, and
# refuses to run unless the database name contains "financeos_test".
#
# Two roles, for the same reason production has two: the harness sets up as the
# migration role, and the code under test connects as the application role, so a
# missing grant fails a test rather than production.
TEST_DATABASE_URL=postgres://financeos_migrator:CHANGE_ME@127.0.0.1:5432/financeos_test
TEST_DATABASE_APP_URL=postgres://financeos_app:CHANGE_ME@127.0.0.1:5432/financeos_test

# --- Secrets ---------------------------------------------------------------
# 32 random bytes, base64. Encrypts TOTP secrets at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this requires re-encrypting every stored TOTP secret.
APP_ENCRYPTION_KEY=

# 32 random bytes, base64. Signs the short-lived cookie that carries a
# half-finished login from the password step to the TOTP step. The session
# cookie itself is an opaque random token and is not signed (SECURITY.md §1).
SESSION_COOKIE_SECRET=

# --- Application -----------------------------------------------------------
# Absolute origin. Used for cookie scoping and absolute redirects.
APP_ORIGIN=http://localhost:3000

# error | warn | info | debug
LOG_LEVEL=info

# --- Market data -----------------------------------------------------------
# Twelve Data — equity and ETF prices for NSE, BSE and international venues.
#
# OPTIONAL. Leave it unset and the application runs normally: mutual funds still
# price from AMFI and FX still comes from Frankfurter, both of which need no
# credential at all. Only equities and ETFs are affected, and they report
# `no_provider` on screen rather than showing a fabricated figure.
#
# India requires the Grow plan or higher (verified 2026-08-17). Get a key from
# https://twelvedata.com/account/api-keys and paste it here — never into a
# commit, a log line, a test fixture, or a chat window.
TWELVE_DATA_API_KEY=

# --- AI (Phase 7) ----------------------------------------------------------
# NVIDIA Build — the model provider (ADR-09).
#
# OPTIONAL, for the same reason the market-data key is. Leave it unset and the
# application starts normally, every financial figure is still computed, and the
# whole deterministic test suite still runs. The provider reports a typed
# `not_configured` error rather than inventing a model result, and the Settings
# surface says the feature is unconfigured.
#
# Get a key from https://build.nvidia.com and write it here — never into a
# commit, a log line, a test fixture, or a chat window. It is read in exactly
# one file, `src/server/ai-runtime.ts`, and passed into the provider; the AI
# layer itself cannot read the environment at all (ADR-38).
NVIDIA_API_KEY=

# Override only to point the smoke test at a local mock. Defaults to
# https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# Tier -> ordered candidate models, comma-separated (ADR-17). Empty means the
# built-in default order in src/server/ai/config/models.ts. Change routing here,
# not in code.
AI_TIER1_MODELS=
AI_TIER2_MODELS=
AI_TIER3_MODELS=
AI_TIER4_MODELS=

# Requests per minute against the AI endpoints, and the ceiling on one provider
# call. One user, so small numbers are the correct ones.
AI_RATE_LIMIT_PER_MINUTE=10
AI_REQUEST_TIMEOUT_MS=60000

# --- Later phases ----------------------------------------------------------
# Deliberately absent until the phase that uses them, so an unset variable is
# never mistaken for a configuration error.
