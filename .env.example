# ---------------------------------------------------------------------------
# Finance OS — environment
#
# Copy to `.env` and fill in. `.env*` is git-ignored; this file is not.
# Every variable here is validated by src/lib/env.ts at startup, which refuses
# to boot on anything missing or malformed (SECURITY.md §3).
#
# Nothing in this file may ever be prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The application role. SELECT/INSERT/UPDATE/DELETE on data tables; INSERT and
# SELECT only on audit_log, which is append-only (SECURITY.md §2, §10).
# It deliberately cannot run DDL.
DATABASE_URL=postgres://financeos_app:CHANGE_ME@127.0.0.1:5432/financeos

# The migration role. Owns the schema and is the only role that may run DDL.
# Used by `npm run db:migrate` and `npm run db:seed` — never by the running
# application process.
DATABASE_MIGRATION_URL=postgres://financeos_migrator:CHANGE_ME@127.0.0.1:5432/financeos

# Integration tests migrate and truncate this database. It must not be the
# development database — the harness truncates every table between files, and
# refuses to run unless the database name contains "financeos_test".
#
# Two roles, for the same reason production has two: the harness sets up as the
# migration role, and the code under test connects as the application role, so a
# missing grant fails a test rather than production.
TEST_DATABASE_URL=postgres://financeos_migrator:CHANGE_ME@127.0.0.1:5432/financeos_test
TEST_DATABASE_APP_URL=postgres://financeos_app:CHANGE_ME@127.0.0.1:5432/financeos_test

# --- Secrets ---------------------------------------------------------------
# 32 random bytes, base64. Encrypts TOTP secrets at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this requires re-encrypting every stored TOTP secret.
APP_ENCRYPTION_KEY=

# 32 random bytes, base64. Signs the short-lived cookie that carries a
# half-finished login from the password step to the TOTP step. The session
# cookie itself is an opaque random token and is not signed (SECURITY.md §1).
SESSION_COOKIE_SECRET=

# --- Application -----------------------------------------------------------
# Absolute origin. Used for cookie scoping and absolute redirects.
APP_ORIGIN=http://localhost:3000

# error | warn | info | debug
LOG_LEVEL=info

# --- Later phases ----------------------------------------------------------
# Deliberately absent until the phase that uses them, so an unset variable is
# never mistaken for a configuration error.
#
# Phase 6 — market data:  MARKET_DATA_* provider credentials
# Phase 7 — AI:           NVIDIA_API_KEY, NVIDIA_BASE_URL, AI_TIER1_MODELS, ...
